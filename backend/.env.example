# Alchemy WebSocket URL for Base Mainnet
ALCHEMY_WSS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Uniswap V3 Router address on Base
UNISWAP_V3_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481

# Server port for Socket.io
PORT=3001

# Risk threshold in ETH
RISK_THRESHOLD_ETH=0.1

# Node environment
NODE_ENV=development

# Network name
NETWORK_NAME=base

# Block explorer URL
EXPLORER_URL=https://basescan.org

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*
