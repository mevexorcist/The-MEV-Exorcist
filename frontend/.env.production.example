# Production Environment Variables for Vercel Deployment
# Copy these to your Vercel project settings under Environment Variables

# Backend Socket.io server URL
# Replace with your deployed backend URL (Railway, Render, etc.)
# Example: https://mev-exorcist-backend.railway.app
NEXT_PUBLIC_BACKEND_URL=https://your-backend-url.railway.app

# Etherscan base URL for Sepolia testnet
# This is used to generate transaction links
NEXT_PUBLIC_ETHERSCAN_BASE=https://sepolia.etherscan.io

# Note: All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Do not include sensitive API keys or secrets here
